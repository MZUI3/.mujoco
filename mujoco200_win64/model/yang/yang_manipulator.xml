<mujoco model="stable_manipulator">
    <compiler angle="degree" inertiafromgeom="true" balanceinertia="true" autolimits="true"/>
    <option timestep="0.002" gravity="0 0 -9.81" iterations="50" solver="CG" tolerance="1e-8"/>

    <visual>
        <global offwidth="1280" offheight="960"/>
        <map znear="0.01" zfar="60" fogstart="8" fogend="30"/>
        <quality shadowsize="2048"/>
    </visual>

    <default>
        <joint damping="1.2" armature="0.02" limited="true" frictionloss="0.02"/>
        <geom condim="3" friction="0.8 0.05 0.02" rgba="0.75 0.75 0.8 1"/>
        <motor ctrllimited="true" ctrlrange="-1 1" forcerange="-5 5"/>
    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.45 0.7" rgb2="0.08 0.12 0.18" width="512" height="512"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1="0.18 0.22 0.28" rgb2="0.10 0.13 0.18" width="256" height="256" mark="cross" markrgb="0.9 0.9 0.9"/>
        <material name="matplane" texture="texplane" texuniform="true" reflectance="0.15"/>
        <material name="matbase" rgba="0.27 0.30 0.35 1"/>
        <material name="matlink1" rgba="0.86 0.32 0.28 1"/>
        <material name="matlink2" rgba="0.27 0.62 0.88 1"/>
        <material name="matlink3" rgba="0.30 0.76 0.48 1"/>
        <material name="matgripper" rgba="0.96 0.83 0.26 1"/>
        <material name="matobject" rgba="0.96 0.40 0.90 1"/>
    </asset>

    <worldbody>
        <light directional="true" diffuse="0.5 0.5 0.5" specular="0.15 0.15 0.15" pos="0 0 5" dir="0 0 -1"/>
        <light directional="true" diffuse="0.7 0.7 0.7" pos="2 2 3" dir="-1 -1 -1"/>

        <geom name="ground" type="plane" size="3 3 0.25" pos="0 0 0" material="matplane" condim="3"/>

        <body name="base" pos="0 0 0.10">
            <geom name="base_plate" type="cylinder" size="0.12 0.06" material="matbase"/>
            <geom name="base_ring" type="cylinder" size="0.08 0.03" pos="0 0 0.04" rgba="0.15 0.17 0.22 1"/>

            <body name="link1" pos="0 0 0.08">
                <joint name="shoulder_pan" type="hinge" axis="0 0 1" range="-180 180"/>
                <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 0.17" size="0.04" material="matlink1"/>

                <body name="link2" pos="0 0 0.17">
                    <joint name="shoulder_lift" type="hinge" axis="0 1 0" range="-90 90"/>
                    <geom name="link2_geom" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035" material="matlink2"/>

                    <body name="link3" pos="0.26 0 0">
                        <joint name="elbow" type="hinge" axis="0 1 0" range="-150 150"/>
                        <geom name="link3_geom" type="capsule" fromto="0 0 0 0.22 0 0" size="0.03" material="matlink3"/>

                        <body name="wrist" pos="0.22 0 0">
                            <joint name="wrist_roll" type="hinge" axis="1 0 0" range="-180 180"/>
                            <geom name="wrist_geom" type="capsule" fromto="0 0 0 0.10 0 0" size="0.025" material="matgripper"/>

                            <body name="gripper_base" pos="0.10 0 0">
                                <geom name="gripper_base_geom" type="box" size="0.02 0.055 0.02" material="matgripper"/>

                                <body name="finger_left" pos="0 0.055 0">
                                    <joint name="finger_left_joint" type="slide" axis="0 1 0" range="0 0.03"/>
                                    <geom name="finger_left_geom" type="box" size="0.012 0.012 0.045" material="matgripper"/>
                                </body>

                                <body name="finger_right" pos="0 -0.055 0">
                                    <joint name="finger_right_joint" type="slide" axis="0 -1 0" range="0 0.03"/>
                                    <geom name="finger_right_geom" type="box" size="0.012 0.012 0.045" material="matgripper"/>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>

        <body name="target_object" pos="0.45 0.0 0.08">
            <freejoint/>
            <geom name="object_geom" type="box" size="0.025 0.025 0.025" material="matobject" mass="0.08"/>
        </body>
    </worldbody>

    <actuator>
        <motor name="act_shoulder_pan" joint="shoulder_pan" gear="60"/>
        <motor name="act_shoulder_lift" joint="shoulder_lift" gear="60"/>
        <motor name="act_elbow" joint="elbow" gear="50"/>
        <motor name="act_wrist_roll" joint="wrist_roll" gear="15"/>
        <motor name="act_finger_left" joint="finger_left_joint" gear="25"/>
        <motor name="act_finger_right" joint="finger_right_joint" gear="25"/>
    </actuator>
</mujoco>
