<mujoco model="simple_manipulator">
    <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>

    <statistic extent="2" meansize=".05"/>

    <option timestep="0.002" solver="Newton" iterations="30" tolerance="1e-10" jacobian="sparse" cone="pyramidal" gravity="0 0 -9.81"/>

    <visual>
        <rgba haze="0.15 0.25 0.35 1"/>
        <quality shadowsize="2048"/>
        <map stiffness="700" shadowscale="0.5" fogstart="10" fogend="15" zfar="40" haze="0.3"/>
    </visual>

    <default>
        <joint limited="true" damping="1" armature="0.01"/>
        <geom rgba="0.7 0.7 0.7 1" condim="4" friction="1 0.5 0.5"/>
        <motor ctrllimited="true"/>
    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2"
            width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
        <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>

        <material name="matlink1" rgba="0.8 0.2 0.2 1"/>
        <material name="matlink2" rgba="0.2 0.6 0.8 1"/>
        <material name="matlink3" rgba="0.2 0.8 0.3 1"/>
        <material name="matgripper" rgba="0.9 0.9 0.2 1"/>
        <material name="matobject" rgba="0.9 0.4 0.9 1"/>
    </asset>

    <worldbody>
        <light directional="true" diffuse=".4 .4 .4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false"/>
        <light directional="true" diffuse=".6 .6 .6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1"/>

        <geom name="ground" type="plane" size="0 0 1" pos="0 0 0" quat="1 0 0 0" material="matplane" condim="3"/>

        <!-- ===================== 매니퓰레이터 베이스 ===================== -->
        <body name="base" pos="0 0 0.05">
            <geom name="base_geom" type="cylinder" size="0.08 0.05" rgba="0.3 0.3 0.3 1"/>

            <!-- 어깨 관절 (yaw, z축 회전) -->
            <body name="link1" pos="0 0 0.05">
                <joint name="shoulder_pan" type="hinge" axis="0 0 1" range="-180 180" pos="0 0 0"/>
                <geom name="link1_geom" type="capsule" fromto="0 0 0  0 0 0.15" size="0.04" material="matlink1"/>

                <!-- 어깨 pitch 관절 -->
                <body name="link2" pos="0 0 0.15">
                    <joint name="shoulder_lift" type="hinge" axis="0 1 0" range="-90 90" pos="0 0 0"/>
                    <geom name="link2_geom" type="capsule" fromto="0 0 0  0.25 0 0" size="0.035" material="matlink2"/>

                    <!-- 팔꿈치 관절 -->
                    <body name="link3" pos="0.25 0 0">
                        <joint name="elbow" type="hinge" axis="0 1 0" range="-150 150" pos="0 0 0"/>
                        <geom name="link3_geom" type="capsule" fromto="0 0 0  0.2 0 0" size="0.03" material="matlink3"/>

                        <!-- 손목 관절 -->
                        <body name="wrist" pos="0.2 0 0">
                            <joint name="wrist_roll" type="hinge" axis="1 0 0" range="-180 180" pos="0 0 0"/>
                            <geom name="wrist_geom" type="capsule" fromto="0 0 0  0.08 0 0" size="0.025" material="matgripper"/>

                            <!-- 그리퍼 (간단한 평행 그리퍼) -->
                            <body name="gripper_base" pos="0.08 0 0">
                                <geom name="gripper_base_geom" type="box" size="0.02 0.05 0.02" material="matgripper"/>

                                <body name="finger_left" pos="0 0.04 0">
                                    <joint name="finger_left_joint" type="slide" axis="0 1 0" range="0 0.03"/>
                                    <geom name="finger_left_geom" type="box" size="0.015 0.01 0.04" material="matgripper"/>
                                </body>

                                <body name="finger_right" pos="0 -0.04 0">
                                    <joint name="finger_right_joint" type="slide" axis="0 -1 0" range="0 0.03"/>
                                    <geom name="finger_right_geom" type="box" size="0.015 0.01 0.04" material="matgripper"/>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>

        <!-- ===================== 집을 물체 ===================== -->
        <body name="target_object" pos="0.4 0 0.05">
            <freejoint/>
            <geom name="object_geom" type="box" size="0.02 0.02 0.02" material="matobject" mass="0.05"/>
        </body>

    </worldbody>

    <!-- ===================== 액추에이터 ===================== -->
    <actuator>
        <motor name="act_shoulder_pan" joint="shoulder_pan" ctrlrange="-2 2" gear="50"/>
        <motor name="act_shoulder_lift" joint="shoulder_lift" ctrlrange="-2 2" gear="50"/>
        <motor name="act_elbow" joint="elbow" ctrlrange="-2 2" gear="30"/>
        <motor name="act_wrist_roll" joint="wrist_roll" ctrlrange="-1 1" gear="10"/>
        <motor name="act_finger_left" joint="finger_left_joint" ctrlrange="0 1" gear="20"/>
        <motor name="act_finger_right" joint="finger_right_joint" ctrlrange="0 1" gear="20"/>
    </actuator>

</mujoco>